# Privy
NEXT_PUBLIC_PRIVY_APP_ID=<your-privy-app-id>
PRIVY_APP_SECRET=<your-privy-app-secret>
PRIVY_DELEGATION_KEY=<your-privy-authorization-private-key>
# Key quorum ID attached to user wallets as an additional signer.
NEXT_PUBLIC_PRIVY_SIGNER_ID=<your-key-quorum-id>
# Comma-separated policy IDs constraining the signer. Empty means full permission.
NEXT_PUBLIC_PRIVY_SIGNER_POLICY_IDS=

# Portfolio data provider: debank | goldrush.
PORTFOLIO_API_PROVIDER=debank

# DeBank
DEBANK_API_KEY=<your-debank-api-key>

# GoldRush (key obtained via QuickNode). Required only when
# PORTFOLIO_API_PROVIDER=goldrush.
GOLDRUSH_API_KEY=

# QuickNode Multichain RPC. Template MUST contain the literal `{network}`
# placeholder, which is substituted per chain (e.g. base-mainnet,
# arbitrum-mainnet, bera-mainnet). Ethereum mainnet is the exception: the
# `.{network}` segment is stripped entirely.
# Example: https://your-name.{network}.quiknode.pro/your-token/
QUICKNODE_MULTICHAIN_URL=
# Optional Admin API key (not required for RPC calls; the token is in the URL).
QUICKNODE_API_KEY=

# APY refresh job (runs in-process; see instrumentation.ts)
# Set to "false" to disable. Interval is in milliseconds (default 1 hour).
APY_REFRESH_ENABLED=true
APY_REFRESH_INTERVAL_MS=3600000

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=<your-db-user>
DB_PASSWORD=<your-db-password>
DB_NAME=<your-db-name>
DB_SCHEMA=test
